APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=true

# Required in production. Use a long, random value (32+ characters).
SECRET_KEY=change-me-to-a-long-random-secret

# Bootstrap the first administrator operator when no operator accounts exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_EMAIL=admin@marginthrive.local
ADMIN_DISPLAY_NAME=Platform Administrator

# Optional operational settings (Phase D1)
# DATABASE_PATH=database.db
# LOG_LEVEL=INFO
# LOG_FILE=logs/marginthrive.log
# BACKUP_DIR=backups
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# TRUST_PROXY=false
# FORCE_HTTPS=true
# SESSION_COOKIE_SECURE=true
